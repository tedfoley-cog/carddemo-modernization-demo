  "overviews": [
    {
      "kind": "module",
      "name": "CARDDEMO",
      "key_points": [
        "Credit card back office: users sign on to CICS screens to view and update accounts, cards and users, add and list transactions and pay bills against VSAM files.",
        "A nightly batch stream posts the day's card transactions (rejecting invalid card, unknown account, over-limit and expired-account items), accrues interest and fees, and produces the transaction report and customer statements."
      ],
      "basis": [
        "app/cbl/COSGN00C.cbl:5",
        "app/cbl/COACTUPC.cbl:4",
        "app/cbl/CBTRN02C.cbl:5",
        "app/cbl/CBACT04C.cbl:5",
        "app/csd/CARDDEMO.CSD:1-40"
      ],
      "written_by": "agent"
    },
    {
      "kind": "chain",
      "name": "CARDDEMO",
      "key_points": [
        "Posts the day's card transactions to accounts and balance categories, rejecting invalid-card, unknown-account, over-limit and expired-account items to a dated reject file.",
        "The same CA-7 schedule also builds customer statements and reloads the transaction type, category and category-balance reference files, with CLOSEFIL/OPENFIL jobs closing and reopening the CICS files around the batch work."
      ],
      "basis": [
        "app/jcl/POSTTRAN.jcl:23-42",
        "app/cbl/CBTRN02C.cbl:385-420",
        "app/scheduler/CardDemo.ca7:18-19",
        "app/scheduler/CardDemo.ca7:70",
        "app/scheduler/CardDemo.ca7:124",
        "app/scheduler/CardDemo.ca7:162",
        "app/scheduler/CardDemo.ca7:244",
        "app/scheduler/CardDemo.ca7:271",
        "app/scheduler/CardDemo.ca7:468"
      ],
      "written_by": "agent"
    },
    {
      "kind": "chain",
      "name": "DAILY-TransactionBackup",
      "key_points": [
        "Daily copy of the posted-transaction file: with the CICS files closed it copies TRANSACT through the REPROC procedure, then deletes and redefines the TRANSACT cluster and its alternate index before the files are reopened."
      ],
      "basis": [
        "app/scheduler/CardDemo.controlm:3-25",
        "app/jcl/TRANBKP.jcl:23-27",
        "app/jcl/TRANBKP.jcl:37-65"
      ],
      "written_by": "agent"
    },
    {
      "kind": "chain",
      "name": "WEEKLY-TransactionTypesDBRefresh",
      "key_points": [
        "Weekly maintenance of the DB2 transaction-type table: runs COBTUPDT under DSN (plan CARDDEMO) against an update file of type code (cols 2-3) and description (cols 4-53)."
      ],
      "basis": [
        "app/scheduler/CardDemo.controlm:26-31",
        "app/app-transaction-type-db2/jcl/MNTTRDB2.jcl:8-30"
      ],
      "written_by": "agent"
    },
    {
      "kind": "chain",
      "name": "DisclosureGroupsRefresh",
      "key_points": [
        "Reloads the disclosure-group (interest rate) file from its flat-file master with the CICS files closed; the interest program reads this file and abends if a DEFAULT rate row is missing."
      ],
      "basis": [
        "app/scheduler/CardDemo.controlm:32-56",
        "app/jcl/DISCGRP.jcl:22-59",
        "app/cbl/CBACT04C.cbl:415-440"
      ],
      "written_by": "agent"
    },
    {
      "kind": "chain",
      "name": "TransactionTypesDBRefresh",
      "key_points": [
        "Backs up the transaction type and category flat files to new generations, then re-extracts them from the DB2 transaction-type table for transaction report generation.",
        "The JCL says it runs once a day, but Control-M defines it in a weekly folder triggered by MNTTRDB2: schedule and documentation disagree."
      ],
      "basis": [
        "app/scheduler/CardDemo.controlm:57-62",
        "app/app-transaction-type-db2/jcl/TRANEXTR.jcl:19-21",
        "app/app-transaction-type-db2/jcl/TRANEXTR.jcl:31-73"
      ],
      "written_by": "agent"
    },
    {
      "kind": "chain",
      "name": "MONTHLY-InterestCalculation",
      "key_points": [
        "Monthly interest and fee accrual: computes interest per account and transaction category from the disclosure-group rates and books it as system transactions merged into the transaction file.",
        "A missing DEFAULT disclosure-group row abends the run, so the month-end cycle depends on reference-data completeness."
      ],
      "basis": [
        "app/scheduler/CardDemo.controlm:64-80",
        "app/cbl/CBACT04C.cbl:415-440",
        "app/jcl/INTCALC.jcl:22-34"
      ],
      "written_by": "agent"
    }
  ],
